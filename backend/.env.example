# ==============================================================================
# Match Day Platform Backend — Environment Variables Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Application name identifier for logs and process management
APP_NAME=matchday

# HTTP server listening port
PORT=3000

# Logging severity level: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent'
LOG_LEVEL=info

# Enable Swagger OpenAPI documentation UI at /docs (true/false)
SWAGGER_ENABLED=true

# ------------------------------------------------------------------------------
# 2. HTTP & Security
# ------------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000

# Maximum request body size payload (e.g. 1mb, 5mb)
BODY_LIMIT=1mb

# Number of reverse proxy hops to trust for client IP resolution
TRUST_PROXY_HOPS=0

# Rate limiter time window in milliseconds (default: 60000ms = 1 minute)
THROTTLE_TTL_MS=60000

# Rate limiter maximum requests allowed within THROTTLE_TTL_MS window
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database
# ------------------------------------------------------------------------------
# PostgreSQL connection string
# Local Supabase default: postgresql://postgres:postgres@127.0.0.1:55322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Maximum connections in the pg connection pool
DATABASE_POOL_MAX=10

# Maximum time (ms) to acquire a connection from the pool before timing out
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Milliseconds before an idle client in the pool is closed
DATABASE_IDLE_TIMEOUT_MS=30000

# Maximum execution time (ms) before a database statement times out
DATABASE_STATEMENT_TIMEOUT_MS=10000

# SSL mode for Postgres: 'disable' | 'require' | 'verify-full'
DATABASE_SSL_MODE=disable

# ------------------------------------------------------------------------------
# 4. Redis & BullMQ Queues
# ------------------------------------------------------------------------------
# Redis connection URL (host:port or full redis URI)
REDIS_URL=redis://127.0.0.1:6379

# Connection establishment timeout in milliseconds
REDIS_CONNECTION_TIMEOUT_MS=5000

# Command execution timeout in milliseconds
REDIS_COMMAND_TIMEOUT_MS=2000

# Maximum retry attempts per Redis request
REDIS_MAX_RETRIES_PER_REQUEST=3

# Prefix namespace for Redis keys to avoid collision
REDIS_NAMESPACE=matchday

# BullMQ default job retry attempts
QUEUE_ATTEMPTS=3

# BullMQ delay in ms between job retry attempts
QUEUE_BACKOFF_DELAY_MS=1000

# Number of completed jobs to keep in history
QUEUE_REMOVE_ON_COMPLETE_COUNT=1000

# Number of failed jobs to keep in history for inspection
QUEUE_REMOVE_ON_FAIL_COUNT=5000

# ------------------------------------------------------------------------------
# 5. Supabase Auth & Storage
# ------------------------------------------------------------------------------
# Base URL of local Supabase API gateway (Kong)
SUPABASE_URL=http://127.0.0.1:55321

# Supabase service role secret key (used for server-to-server operations and storage access)
SUPABASE_SECRET_KEY=local-supabase-secret-key

# Supabase publishable / anon key
SUPABASE_PUBLISHABLE_KEY=local-supabase-anon-key

# Supabase JWT token issuer URL
SUPABASE_AUTH_ISSUER=http://127.0.0.1:55321/auth/v1

# Expected audience claim in Supabase JWTs
SUPABASE_AUTH_AUDIENCE=authenticated

# Auth verification strategy: 'jwks' (validates JWT locally against JWKS) | 'remote' (calls Supabase Auth API)
SUPABASE_AUTH_MODE=jwks

# Timeout in ms for remote auth verification requests
SUPABASE_AUTH_VERIFICATION_TIMEOUT_MS=3000

# Maximum age in ms to cache the JWKS public keys
SUPABASE_JWKS_CACHE_MAX_AGE_MS=600000

# Minimum cooldown period in ms between JWKS refresh attempts on unknown keys
SUPABASE_JWKS_COOLDOWN_MS=30000
