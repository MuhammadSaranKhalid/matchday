{
  "name": "matchday-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm build:api && pnpm build:worker && pnpm verify:dist",
    "build:api": "nest build api && tsc-alias -p apps/api/tsconfig.app.json",
    "build:worker": "nest build worker && tsc-alias -p apps/worker/tsconfig.app.json",
    "lint": "oxlint apps libs test vitest.config.ts",
    "test": "vitest run test/unit",
    "test:architecture": "vitest run test/architecture",
    "test:e2e": "vitest run test/e2e",
    "verify:dist": "node -e \"Promise.all([import('./dist/apps/api/apps/api/src/api.module.js'),import('./dist/apps/worker/apps/worker/src/worker.module.js')])\"",
    "start:api": "node dist/apps/api/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/apps/worker/src/main.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@supabase/supabase-js": "2.117.2",
    "blurhash": "2.0.5",
    "bullmq": "6.3.9",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.2.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.7",
    "@nestjs/testing": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "oxlint": "1.85.0",
    "supertest": "7.3.0",
    "tsc-alias": "1.8.16",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
