{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@app/api/*": ["./apps/api/src/*"],
      "@app/worker/*": ["./apps/worker/src/*"],
      "@modules/posts": ["./libs/modules/posts/src/index.ts"],
      "@modules/media": ["./libs/modules/media/src/index.ts"],
      "@modules/tournaments": ["./libs/modules/tournaments/src/index.ts"],
      "@platform/*": ["./libs/platform/src/*"],
      "@shared-kernel": ["./libs/shared-kernel/src/index.ts"],
      "@shared-kernel/*": ["./libs/shared-kernel/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
