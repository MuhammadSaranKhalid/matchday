{
  "name": "matchday-media-worker",
  "version": "1.0.0",
  "description": "Matchday Firebase Cloud Tasks + Functions 2nd Gen image processing worker with Sharp",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "blurhash": "^2.0.5",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "private": true,
  "engines": {
    "node": "22"
  }
}
